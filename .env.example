# Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables

# Connection string Neon (Dashboard Neon > Connect), pakai yang "pooled"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# String acak panjang untuk menandatangani sesi login (min. 32 karakter)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Pengirim email. Domain harus sudah diverifikasi di Resend (mis. noreply@mekansm.com).
# onboarding@resend.dev hanya bisa mengirim ke email pemilik akun Resend (untuk testing).
RESEND_FROM=Rekap Reimburse <noreply@mekansm.com>

# URL publik website (dipakai untuk link verifikasi & link foto di Excel)
APP_URL=https://nama-project.vercel.app

# Akun admin (dibuat otomatis saat database pertama kali diinisialisasi)
ADMIN_EMAIL=admin@mekansm.com
ADMIN_PASSWORD=Novarion1
